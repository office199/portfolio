# .gitignore

# ─── ENVIRONMENT VARIABLES & SECRETS ───
# Never upload API keys, passwords, or credentials
.env
.env.local
.env.*.local
*.env
*.pem
*.key

# ─── DEPENDENCIES ───
# Package managers download these locally; do not track them
node_modules/
bower_components/
jspm_packages/
.pnpm-store/

# ─── BUILD & OUTPUT DIRECTORIES ───
# Generated code, binaries, and distribution packages
dist/
build/
out/
bin/
obj/
*.exe
*.dll
*.so
*.war
*.ear

# ─── LOGS AND CACHES ───
# Temporary files generated during runtime
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache
.cache/

# ─── SYSTEM & OS FILES ───
# Files created automatically by your Operating System
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# ─── IDE & CODE EDITORS ───
# Personal editor settings should remain local
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
